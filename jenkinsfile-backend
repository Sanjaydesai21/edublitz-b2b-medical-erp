pipeline {
    agent 'any'

    tools {
        maven 'maven1'
    }

    environment {
        my_aws_credential = credentials('aws-access')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'dev', url: 'https://github.com/Sanjaydesai21/edublitz-b2b-medical-erp.git'
            }
        }

        stage('User-service-build'){
            steps{
                dir('user-service') {
                    sh 'mvn clean package -DskipTests'
                }
            }

            post{
                success{
                    archiveArtifacts artifacts: 'user-service/target/*.jar', fingerprint: true
                }
            }

        }

        stage('SonarQube Analysis - user-service') {
            steps {
                withSonarQubeEnv('sonar') {
                    dir('user-service') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Product-service-build'){
            steps{
                dir('product-service') {
                    sh 'mvn clean package -DskipTests'
                }
            }

            post{
                success{
                    archiveArtifacts artifacts: 'product-service/target/*.jar', fingerprint: true
                }
            }

        }

        stage('SonarQube Analysis - product-service') {
            steps {
                withSonarQubeEnv('sonar') {
                    dir('product-service') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Order-service-build'){
            steps{
                dir('order-service') {
                    sh 'mvn clean package -DskipTests'
                }
            }

            post{
                success{
                    archiveArtifacts artifacts: 'order-service/target/*.jar', fingerprint: true
                }
            }

        }

        stage('SonarQube Analysis - order-service') {
            steps {
                withSonarQubeEnv('sonar') {
                    dir('order-service') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }
    }
}


pipeline {
    agent 'any'

    tools {
        maven 'maven1'
        jdk 'JDK17'
    }

    environment {
        my_aws_credential = credentials('aws-access')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'dev', url: 'https://github.com/Sanjaydesai21/edublitz-b2b-medical-erp.git'
            }
        }

        stage('User-service-build'){
            steps{
                dir('user-service') {
                    sh 'mvn clean package -DskipTests'
                }
            }

            post{
                success{
                    archiveArtifacts artifacts: 'user-service/target/*.jar', fingerprint: true
                }
            }

        }

        stage('SonarQube Analysis - user-service') {
            steps {
                withSonarQubeEnv('sonar') {
                    dir('user-service') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Product-service-build'){
            steps{
                dir('product-service') {
                    sh 'mvn clean package -DskipTests'
                }
            }

            post{
                success{
                    archiveArtifacts artifacts: 'product-service/target/*.jar', fingerprint: true
                }
            }

        }

        stage('SonarQube Analysis - product-service') {
            steps {
                withSonarQubeEnv('sonar') {
                    dir('product-service') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Order-service-build'){
            steps{
                dir('order-service') {
                    sh 'mvn clean package -DskipTests'
                }
            }

            post{
                success{
                    archiveArtifacts artifacts: 'order-service/target/*.jar', fingerprint: true
                }
            }

        }

        stage('SonarQube Analysis - order-service') {
            steps {
                withSonarQubeEnv('sonar') {
                    dir('order-service') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage("Docker Build and Push "){
            steps{
                sh '''
                aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 194226864100.dkr.ecr.ap-south-1.amazonaws.com

                docker build -t user-service user-service/.
                docker tag user-service:latest 194226864100.dkr.ecr.ap-south-1.amazonaws.com/user-service:latest
                docker push 194226864100.dkr.ecr.ap-south-1.amazonaws.com/user-service:latest

                docker build -t products-service product-service/.
                docker tag products-service:latest 194226864100.dkr.ecr.ap-south-1.amazonaws.com/products-service:latest
                docker push 194226864100.dkr.ecr.ap-south-1.amazonaws.com/products-service:latest

                docker build -t orders-service order-service/.
                docker tag orders-service:latest 194226864100.dkr.ecr.ap-south-1.amazonaws.com/orders-service:latest
                docker push 194226864100.dkr.ecr.ap-south-1.amazonaws.com/orders-service:latest
                '''
            }
        }

        

    }
}

